{
  "name": "tv-tracker",
  "private": true,
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "prisma generate && react-router build && mkdir -p build/server/generated/prisma && cp -r app/generated/prisma build/server/generated/",
    "delete:episode": "tsx scripts/delete-episode.ts",
    "delete:season": "tsx scripts/delete-season.ts",
    "delete:episode:id": "tsx scripts/delete-episode-by-id.ts",
    "delete:episode-link": "tsx scripts/remove-inexistent-episode-links.ts",
    "dev:deps": "docker compose -f docker-compose.dev.yml up -d",
    "dev:deps:stop": "docker compose -f docker-compose.dev.yml stop",
    "postinstall": "prisma generate",
    "prepare": "vp config",
    "setup": "prisma generate && prisma db push && prisma db seed",
    "start": "react-router-serve ./build/server/index.js",
    "test:e2e": "vp run test:e2e:setup && vp run test:e2e:run && vp run test:e2e:teardown",
    "test:e2e:report": "playwright show-report",
    "test:e2e:run": "node --env-file=.env.e2e ./node_modules/playwright/cli.js test",
    "test:e2e:setup": "docker compose -f docker-compose.e2e.yml up -d && sh -c 'for i in $(seq 1 30); do if node --env-file=.env.e2e ./node_modules/prisma/build/index.js db push --accept-data-loss 2>/dev/null; then break; fi; echo \"Waiting for PostgreSQL ($i/30)...\"; sleep 2; done' && node --env-file=.env.e2e ./node_modules/prisma/build/index.js db seed",
    "test:e2e:teardown": "docker compose -f docker-compose.e2e.yml down -v",
    "update:episode:force": "tsx scripts/force-episode-update.ts",
    "update:mazeId": "tsx scripts/update-maze-id.ts",
    "update:episodes": "tsx scripts/get-new-episodes.ts",
    "update:episodes:info": "tsx scripts/update-episodes.ts",
    "update:show:status": "tsx scripts/update-show-status.ts",
    "update:show:endDate": "tsx scripts/update-end-date.ts",
    "validate": "vp check && vp test && pnpm run test:e2e"
  },
  "dependencies": {
    "@flipt-io/flipt": "^1.5.0",
    "@heroicons/react": "^2.2.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@react-router/node": "^8.4.0",
    "@react-router/serve": "^8.4.0",
    "@sentry/cli": "^3.8.0",
    "@sentry/node": "^10.75.3",
    "@sentry/react-router": "^10.75.3",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "entities": "^8.1.0",
    "isbot": "^5.2.2",
    "nodemailer": "^10.0.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "recharts": "^3.10.1",
    "striptags": "^3.2.0",
    "tiny-invariant": "^1.3.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.63.0",
    "@react-router/dev": "^8.4.0",
    "@react-router/fs-routes": "^8.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "5.0.2",
    "@vitest/coverage-v8": "5.0.2",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite-plus": "^1.0.0",
    "vitest-browser-react": "^2.3.0",
    "vitest-mock-extended": "^5.1.1",
    "wait-on": "^9.5.1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.24.0",
  "version": "2.0.0"
}
